generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  WORKER
  CLIENT
}

enum NotificationType {
  INFO
  WELCOME
  ORDER_REGISTERED
  ORDER_PACKED
  ORDER_UNPACKED
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  login        String         @unique @db.VarChar(254)
  passwordHash String         @map("password_hash") @db.VarChar(100)
  role         Role           @default(WORKER)
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  client       ClientAccount?
  operations   OperationLog[]
  manifests    Manifest[]     @relation("ManifestCreatedBy")

  @@map("app_user")
}

model Receiver {
  id           String          @id @default(uuid()) @db.Uuid
  clientCode   String          @unique @map("client_code") @db.VarChar(50)
  firstName    String          @map("first_name") @db.VarChar(120)
  lastName     String          @map("last_name") @db.VarChar(120)
  packageShoes Int             @default(0) @map("package_shoes")
  bagPackage   Int             @default(0) @map("bag_package")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  account      ClientAccount?
  orders       ShipmentOrder[]

  @@map("receiver")
}

model ClientAccount {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @unique @map("user_id") @db.Uuid
  receiverId         String               @unique @map("receiver_id") @db.Uuid
  email              String               @unique @db.VarChar(254)
  phone              String?              @db.VarChar(40)
  address            String?              @db.VarChar(500)
  emailNotifications Boolean              @default(true) @map("email_notifications")
  pushNotifications  Boolean              @default(true) @map("push_notifications")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiver           Receiver             @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  notifications      ClientNotification[]

  @@map("client_account")
}

model ClientNotification {
  id              String           @id @default(uuid()) @db.Uuid
  clientAccountId String           @map("client_account_id") @db.Uuid
  type            NotificationType @default(INFO)
  title           String           @db.VarChar(160)
  message         String           @db.VarChar(1000)
  readAt          DateTime?        @map("read_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  account         ClientAccount    @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@index([clientAccountId, createdAt])
  @@map("client_notification")
}

model PartialBatch {
  id            String         @id @default(uuid()) @db.Uuid
  codeId        String         @unique @map("code_id") @db.VarChar(50)
  partialCode   String         @unique @map("partial_code") @db.VarChar(100)
  partialName   String         @map("partial_name") @db.VarChar(160)
  warehouseName String         @default("BMG") @map("warehouse_name") @db.VarChar(120)
  status        Int            @default(0)
  grossWeight   Decimal?       @map("gross_weight") @db.Decimal(12, 3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  boxes         WarehouseBox[]
  manifest      Manifest?

  @@map("partial_batch")
}

model WarehouseBox {
  id            String          @id @default(uuid()) @db.Uuid
  codeId        String          @unique @map("code_id") @db.VarChar(50)
  trackingCode  String          @unique @map("tracking_code") @db.VarChar(160)
  warehouse     String          @default("BMG") @db.VarChar(120)
  warehouseGuid String?         @map("warehouse_guid") @db.Uuid
  width         Int             @default(0)
  height        Int             @default(0)
  length        Int             @default(0)
  volumeWeight  Decimal         @default(0) @map("volume_weight") @db.Decimal(12, 3)
  grossWeight   Decimal?        @map("gross_weight") @db.Decimal(12, 3)
  status        Int             @default(0)
  partialId     String?         @map("partial_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  partial       PartialBatch?   @relation(fields: [partialId], references: [id], onDelete: SetNull)
  orders        ShipmentOrder[]

  @@index([status])
  @@index([partialId])
  @@map("warehouse_box")
}

model ShipmentOrder {
  id                 String            @id @default(uuid()) @db.Uuid
  trackingNumber     String            @unique @map("tracking_number") @db.VarChar(160)
  clientName         String?           @map("client_name") @db.VarChar(240)
  clientCode         String?           @map("client_code") @db.VarChar(50)
  receiverId         String?           @map("receiver_id") @db.Uuid
  withBox            Int               @default(0) @map("with_box")
  grossWeight        Decimal?          @map("gross_weight") @db.Decimal(12, 3)
  length             Int?
  width              Int?
  height             Int?
  statusName         String            @default("REGISTERED") @map("status_name") @db.VarChar(100)
  boxId              String?           @map("box_id") @db.Uuid
  boxDescription     String?           @map("box_description") @db.VarChar(240)
  compositionId      String?           @map("composition_id") @db.Uuid
  productDescription String?           @map("product_description") @db.VarChar(500)
  declaredValue      Decimal?          @map("declared_value") @db.Decimal(12, 2)
  currency           String            @default("EUR") @db.VarChar(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  receiver           Receiver?         @relation(fields: [receiverId], references: [id], onDelete: SetNull)
  box                WarehouseBox?     @relation(fields: [boxId], references: [id], onDelete: SetNull)
  composition        OrderComposition? @relation(fields: [compositionId], references: [id], onDelete: SetNull)

  @@index([receiverId])
  @@index([boxId])
  @@index([compositionId])
  @@map("shipment_order")
}

model OrderComposition {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique @db.VarChar(50)
  name      String          @db.VarChar(120)
  enabled   Boolean         @default(true)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  orders    ShipmentOrder[]

  @@index([enabled, sortOrder])
  @@map("order_composition")
}

model ClientCodeConfig {
  id            Int      @id @default(1) @db.SmallInt
  codePrefix    String   @default("KG") @map("code_prefix") @db.VarChar(12)
  warehouseName String   @default("BMG") @map("warehouse_name") @db.VarChar(120)
  country       String   @default("España") @db.VarChar(120)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("client_code_config")
}

model Manifest {
  id              String         @id @default(uuid()) @db.Uuid
  manifestCode    String         @unique @map("manifest_code") @db.VarChar(120)
  partialBatchId  String         @unique @map("partial_batch_id") @db.Uuid
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  warehouseName   String         @map("warehouse_name") @db.VarChar(120)
  country         String         @db.VarChar(120)
  batchCode       String         @map("batch_code") @db.VarChar(100)
  batchName       String         @map("batch_name") @db.VarChar(160)
  boxCount        Int            @map("box_count")
  orderCount      Int            @map("order_count")
  grossWeight     Decimal        @default(0) @map("gross_weight") @db.Decimal(12, 3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  partialBatch    PartialBatch   @relation(fields: [partialBatchId], references: [id], onDelete: Restrict)
  createdBy       User           @relation("ManifestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items           ManifestItem[]

  @@index([createdAt])
  @@map("manifest")
}

model ManifestItem {
  id                 String   @id @default(uuid()) @db.Uuid
  manifestId         String   @map("manifest_id") @db.Uuid
  sourceOrderId      String   @map("source_order_id") @db.Uuid
  trackingNumber     String   @map("tracking_number") @db.VarChar(160)
  clientCode         String?  @map("client_code") @db.VarChar(50)
  clientName         String?  @map("client_name") @db.VarChar(240)
  clientFirstName    String?  @map("client_first_name") @db.VarChar(120)
  clientLastName     String?  @map("client_last_name") @db.VarChar(120)
  clientEmail        String?  @map("client_email") @db.VarChar(320)
  clientPhone        String?  @map("client_phone") @db.VarChar(40)
  clientAddress      String?  @map("client_address") @db.VarChar(500)
  compositionName    String?  @map("composition_name") @db.VarChar(120)
  productDescription String?  @map("product_description") @db.VarChar(500)
  declaredValue      Decimal? @map("declared_value") @db.Decimal(12, 2)
  currency           String?  @db.VarChar(3)
  grossWeight        Decimal? @map("gross_weight") @db.Decimal(12, 3)
  boxTrackingCode    String   @map("box_tracking_code") @db.VarChar(160)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  manifest           Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  @@unique([manifestId, sourceOrderId])
  @@index([clientCode])
  @@map("manifest_item")
}

model OperationLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(20)
  route      String   @db.VarChar(255)
  entityType String?  @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("operation_log")
}

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="значения в см"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText android:id="@+id/etLength" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Длина (L)" android:inputType="numberDecimal" />
    <EditText android:id="@+id/etWidth" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ширина (W)" android:inputType="numberDecimal" />
    <EditText android:id="@+id/etHeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Высота (H)" android:inputType="numberDecimal" />

    <TextView
        android:id="@+id/tvResultPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Итого: 0.00 кг"
        android:gravity="center"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:textColor="#2E7D32"/>

    <Button
        android:id="@+id/btnApplyVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ПРИМЕНИТЬ"
        android:layout_marginTop="16dp" />
</LinearLayout>
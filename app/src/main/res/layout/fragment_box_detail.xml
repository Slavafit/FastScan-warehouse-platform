<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Один-единственный прямой ребёнок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Шапка -->
        <TextView
            android:id="@+id/tvBoxNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Номер коробки"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGrossWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Общий вес: 0.0 кг"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvVWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Объёмный вес: 0.0 кг"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvOrderCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Заказов: 0"
            android:textSize="16sp" />

        <!-- Блок размеров -->
        <LinearLayout
            android:id="@+id/layoutSizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/etLength"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Длина (см)"
                android:inputType="number" />

            <EditText
                android:id="@+id/etWidth"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Ширина (см)"
                android:inputType="number"
                android:layout_marginHorizontal="8dp" />

            <EditText
                android:id="@+id/etHeight"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Высота (см)"
                android:inputType="number" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сохранить размеры"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF" />

        <!-- Список заказов -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center" />

        <Button
            android:id="@+id/btnAddOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сканировать трек заказа" />

        <Button
            android:id="@+id/btnPrint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Печать лейбла" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Обновить" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Назад" />


    </LinearLayout>

</ScrollView>


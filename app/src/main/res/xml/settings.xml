<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/language_settings">
        <ListPreference
            android:key="language"
            android:title="@string/language"
            android:entries="@array/language_entries"
            android:entryValues="@array/language_values"
            android:defaultValue="ru"
            android:negativeButtonText="@string/cancel"
            android:positiveButtonText="@string/ok" />
        <!--android:summary="@string/language_summary"-->

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/server_settings">

        <EditTextPreference
            app:key="api_url"
            app:title="@string/server_url_title"
            app:useSimpleSummaryProvider="true"
            android:summary="@string/server_url_summary"/>
        <!--app:defaultValue="https://onza-api.ibm.kg" />-->

        <EditTextPreference
            app:key="login"
            app:title="@string/login_title"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="password"
            app:title="@string/password_title"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="vol_weight"
            app:title="@string/vol_weight_title"
            app:summary="@string/vol_weight_summary"
            app:useSimpleSummaryProvider="true"
            android:inputType="number"/>

        <EditTextPreference
            app:key="weight_server_url"
            app:title="@string/server_weight_address"
            app:summary="@string/server_weight_address_summary"
            app:defaultValue="http://192.168.1.169"
            app:useSimpleSummaryProvider="true"
            android:inputType="textUri"/>

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/licence_title">
        <EditTextPreference
            android:key="user_email"
            android:title="@string/licence_email_title"
            android:summary="@string/licence_email_summary"
            android:defaultValue=""
            android:inputType="textEmailAddress" />
        <Preference
            android:key="license_status"
            android:title="@string/licence_status_title"
            android:summary="@string/licence_status_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/developer_info_title">
        <Preference
            android:key="developer_info"
            android:title="@string/developer_title"
            android:summary="@string/developer_summary"/>
    </PreferenceCategory>
</PreferenceScreen>


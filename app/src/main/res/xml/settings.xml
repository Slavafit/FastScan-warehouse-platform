<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <resources>
        <string name="app_name">FastScan</string>
        <string name="open_boxes">Открытые коробки</string>
        <string name="all_boxes">Все коробки</string>
        <string name="scan_track">Сканировать трек заказа</string>
        <string name="save_sizes">Сохранить размеры</string>
        <string name="print_label">Печать лейбла</string>
        <!-- все остальные строки -->
    </resources>

    <PreferenceCategory app:title="Настройки сервера">

        <EditTextPreference
            app:key="api_url"
            app:title="URL сервера"
            app:useSimpleSummaryProvider="true"
            android:summary="По умолчанию:https://onza-api.ibm.kg"/>
        <!--app:defaultValue="https://onza-api.ibm.kg" />-->

    <EditTextPreference
        app:key="login"
        app:title="Логин"
        app:useSimpleSummaryProvider="true" />

    <EditTextPreference
        app:key="password"
        app:title="Пароль"
        app:useSimpleSummaryProvider="true" />

    <EditTextPreference
        app:key="vol_weight"
        app:title="Объемный вес"
        app:summary="По умолчанию: 6000"
        app:useSimpleSummaryProvider="true"
        android:inputType="number"/>

</PreferenceCategory>
    <PreferenceCategory android:title="Лицензия">
        <EditTextPreference
            android:key="user_email"
            android:title="Email для лицензии"
            android:summary="Введите email, привязанный к лицензии"
            android:defaultValue=""
            android:inputType="textEmailAddress" />
        <Preference
            android:key="license_status"
            android:title="Статус лицензии"
            android:summary="Проверка..." />
    </PreferenceCategory>
    <PreferenceCategory android:title="О разработчике">
        <Preference
            android:key="developer_info"
            android:title="Вячеслав Фитлин"
            android:summary="Телеграмм: @Slavafit"/>
    </PreferenceCategory>
</PreferenceScreen>


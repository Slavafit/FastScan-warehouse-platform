<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Настройки сервера">

        <EditTextPreference
            app:key="api_url"
            app:title="URL сервера"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="https://onza-api.ibm.kg/" />

        <EditTextPreference
            app:key="login"
            app:title="Логин"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="password"
            app:title="Пароль"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</PreferenceScreen>